      { "name" : "r8", "bitsize" : 32, "type" : "uint32" },
      { "name" : "fp", "bitsize" : 32, "type" : "data_ptr", "group" : "general" },
      { "name" : "ap", "bitsize" : 32, "type" : "data_ptr", "group" : "general" },
      { "name" : "psw", "bitsize" : 32, "type" : "uint32", "group" : "general" },
      { "name" : "sp", "bitsize" : 32, "type" : "data_ptr", "group" : "general" },
      { "name" : "pcbp", "bitsize" : 32, "type" : "data_ptr", "group" : "general" },
      { "name" : "isp", "bitsize" : 32, "type" : "data_ptr", "group" : "general" },
      { "name" : "pc", "bitsize" : 32, "type" : "code_ptr", "group" : "general" }
