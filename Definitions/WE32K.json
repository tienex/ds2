        "uar" : { "description" : "Unaligned Access Register" },
        "tcr" : { "description" : "Timer Control Register" }
      }
    },
    "debug-regs" : {
      "bit-size" : 32,
      "description" : "Debug and Breakpoint Registers",
      "registers" : {
        "dr0" : { "description" : "Debug Register 0" },
        "dr1" : { "description" : "Debug Register 1" },
        "dr2" : { "description" : "Debug Register 2" },
        "dr3" : { "description" : "Debug Register 3" },
        "dcr" : { "description" : "Debug Control Register" },
        "dsr" : { "description" : "Debug Status Register" }
      }
    }
  },
  "gdb-defs" : {
