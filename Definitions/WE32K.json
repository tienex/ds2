    "mau-registers" : [
      { "name" : "d0", "bitsize" : 64, "type" : "ieee_double", "group" : "float" },
      { "name" : "d1", "bitsize" : 64, "type" : "ieee_double", "group" : "float" },
      { "name" : "d2", "bitsize" : 64, "type" : "ieee_double", "group" : "float" },
      { "name" : "d3", "bitsize" : 64, "type" : "ieee_double", "group" : "float" },
      { "name" : "masr", "bitsize" : 32, "type" : "uint32", "group" : "float" },
      { "name" : "macr", "bitsize" : 32, "type" : "uint32", "group" : "float" }
    ]
